{
  "manifest_version": 2,
  "name": "Claude Console Debugger",
  "version": "1.0.0",
  "description": "Capture console errors and send to Claude CLI",
  
  "permissions": [
    "activeTab",
    "storage",
    "<all_urls>"
  ],
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  
  "browser_action": {
    "default_popup": "popup-advanced.html",
    "default_title": "Claude Console Debugger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "web_accessible_resources": ["injected.js"],
  
  "applications": {
    "gecko": {
      "id": "claude-debugger@claude.dev",
      "strict_min_version": "57.0"
    }
  }
}